{
  "get": {
    "summary": "Get Accounts Forged Blocks",
    "description": "Gets the blocks an account forged, newest first. A response stops early once the returned blocks hold `API.BlocksMaxTransactions` transactions (default 10000); continue with `nextIndex` until it is absent. At least one block is always returned.",
    "tags": [
      "account",
      "mining"
    ],
    "parameters": [
      {
        "$ref": "../../parameters/account/account.json"
      },
      {
        "$ref": "../../parameters/timestamp.json"
      },
      {
        "$ref": "../../parameters/firstIndex.json"
      },
      {
        "$ref": "../../parameters/lastIndex.json"
      },
      {
        "name": "includeTransactions",
        "in": "query",
        "description": "If set `true` the transaction objects will be returned, otherwise the transaction identifiers",
        "required": false,
        "schema": {
          "type": "boolean",
          "example": [
            true,
            false
          ]
        }
      }
    ],
    "responses": {
      "200": {
        "description": "List of forged blocks",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "required": [
                "blocks"
              ],
              "properties": {
                "nextIndex": {
                  "$ref": "../../schemas/nextIndex.json"
                },
                "blocks": {
                  "type": "array",
                  "items": {
                    "$ref": "../../schemas/block.json"
                  }
                }
              }
            }
          }
        }
      },
      "500": {
        "$ref": "../../responses/error.json"
      }
    }
  }
}